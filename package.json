{
  "name": "nexus-ai",
  "version": "2.0.0",
  "private": true,
  "description": "NEXUS AI — Social Intelligence Platform. AI-powered social media command center.",
  "type": "module",
  "scripts": {
    "cli": "tsx src/cli.ts",
    "schedule": "tsx src/cli.ts schedule",
    "list": "tsx src/cli.ts list",
    "cancel": "tsx src/cli.ts cancel",
    "post": "tsx src/cli.ts post",
    "build": "npm run build:backend",
    "build:backend": "cd backend && go build -o ../dist/nexus-server .",
    "build:frontend": "cd frontend && npx next build",
    "ui": "tsx src/server.ts",
    "dev": "concurrently -n go,next -c cyan,magenta \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && go run .",
    "frontend": "cd frontend && npx next dev",
    "lint": "cd frontend && npx next lint",
    "start": "concurrently -n go,next -c cyan,magenta \"cd backend && ./nexus-server\" \"cd frontend && npx next start\""
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.15.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "next": "16.2.6",
    "openai": "^4.73.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
