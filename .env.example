# ─── AI Providers ─────────────────────────────────────────────────────────────
# Option A: OpenAI (paid, ~$0.15/million tokens)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option B: Groq (FREE, no credit card, 30 req/min)
# Get a free key at https://console.groq.com → uses Llama 3.1 70B
# Tried first → falls back to computed if both fail
GROQ_API_KEY=

# ─── Social Platform Tokens (for real publishing via API) ────────────────────
# X/Twitter: https://developer.twitter.com → create project → Bearer Token
# Note: Bearer Token is app-only (READ ONLY) — cannot post!
# For posting you need OAuth 1.0a user tokens (Access Token + Secret)
xConsumerKey=
xSecretKey=
xBearerToken=

# ─── Browser Auth Workaround (like WhatsApp web automation) ──────────────────
# Uses Playwright to post via the web interface — no API tokens needed.
# No passwords stored in env. Run the auth command to login manually:
#   npm run auth:x         # X/Twitter
#   npm run auth:linkedin  # LinkedIn
#   npm run auth:facebook  # Facebook
#   npm run auth:instagram # Instagram (text stories)
#   npm run auth:threads   # Threads
USE_BROWSER_AUTH=true

# ─── Mock Clients (for testing without real posting) ─────────────────────────
USE_MOCK_CLIENTS=false

# ─── Storage ──────────────────────────────────────────────────────────────────
SCHEDULER_DATA_DIR=./data
